{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "figma-make-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "index": "index.html",
            "outputPath": "dist",
            "tsConfig": "tsconfig.json",
            "styles": ["src/index.css"],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/imports",
                "output": "imports"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "figma-make-app:build:production"
            },
            "development": {
              "buildTarget": "figma-make-app:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 8443
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
